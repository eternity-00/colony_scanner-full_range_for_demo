root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
